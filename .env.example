# Copy to .env.local and fill in. Nothing here is a real value.
#
# The running app also tells you which of these are missing: Settings → Plan,
# "Server configuration" (team accounts), and the server log at startup. Be
# careful trusting a green result from a dev server you did not start
# yourself — a parent process can pass a variable down, and that variable
# will not exist in a plain terminal or on Vercel.

# ── Required ────────────────────────────────────────────────────────────────

# Supabase project URL and the public anon key. Without these there is no
# sign-in and no database; nothing works.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Every message fails without it.
ANTHROPIC_API_KEY=

# Server only, and the dangerous one to forget: plans and metering are written
# with it precisely because the user must not be able to write them. Missing,
# nothing errors — every account simply reads as the free plan and agxp_usage
# stays empty, which looks exactly like a working free tier. See CLAUDE.md.
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional ────────────────────────────────────────────────────────────────

# Emailing an invitation instead of copying the code by hand. Without the key
# the invitation is still created and still works — only the sending is
# skipped. The key on its own is enough to start.
RESEND_API_KEY=

# Optional. Left empty, invitations go out from Resend's sandbox address,
# which only reaches the Resend account owner — fine for checking the flow,
# useless for inviting anyone. To reach other people, verify a domain with
# Resend and put an address on it here, with a display name:
#   INVITE_FROM=AgentiX Projects <invite@yourdomain.com>
INVITE_FROM=

# Optional. The id or alias of a PUBLISHED Resend template, e.g.
# beta-invitation. The template must declare exactly two variables, spelled
# BETA_KEY and APP_URL. Left empty, the email built into lib/send-mail.ts is
# used — which is also what happens automatically if the template send fails,
# so a renamed template costs you a note in the panel, not an invitation.
INVITE_TEMPLATE=

# Optional. The subject line. A template carries its own design but not the
# subject, so this applies with or without one.
# Default: Your invitation to AgentiX Projects
INVITE_SUBJECT=


# Error reports from production. Sentry only initialises when NODE_ENV is
# production AND this is set, so leaving it empty is fine for local work.
NEXT_PUBLIC_SENTRY_DSN=

# Only for uploading source maps to Sentry during a build. Without them the
# build still succeeds and errors still arrive — the stack traces are minified.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# The origin that link previews resolve against. Vercel sets
# VERCEL_PROJECT_PRODUCTION_URL on its own, so this is only for a self-hosted
# build or a custom domain.
NEXT_PUBLIC_SITE_URL=

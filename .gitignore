# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries no values and is the only place
# that says what a fresh clone needs.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Skills installed by `npx skills add` symlink themselves in here with an
# absolute path to this machine. The real files live in .agents/skills and
# are committed; the symlink is local only and would break anywhere else.
/.claude/skills/apple-design

# Generated by scripts/testfaelle.mjs — a run of the real agent, not source.
testfaelle.html
